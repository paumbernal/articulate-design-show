{
  "description": "One instance of a signal detector firing on a specific bar.\n\nThis is the \"what we detected\" layer \u2014 a raw, pre-hypothesis observation.\nWhether a condition matters is decided later by a SetupDefinition's\nweighted rules, not by the detector itself.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "symbol": {
      "enum": [
        "MES",
        "MNQ"
      ],
      "title": "Symbol",
      "type": "string"
    },
    "timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "30m",
        "1h"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "barIndex": {
      "minimum": 0,
      "title": "Barindex",
      "type": "integer"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "signalType": {
      "description": "Key into the signal registry, e.g. 'liquidity_sweep', 'absorption'",
      "title": "Signaltype",
      "type": "string"
    },
    "direction": {
      "enum": [
        "bullish",
        "bearish"
      ],
      "title": "Direction",
      "type": "string"
    },
    "strength": {
      "description": "Detector's own confidence, independent of Edge Score weight",
      "maximum": 1,
      "minimum": 0,
      "title": "Strength",
      "type": "number"
    },
    "evidence": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "integer"
          },
          {
            "type": "string"
          }
        ]
      },
      "description": "Structured explanation, e.g. {'swept_level': 4512.25, 'volume_multiple': 3.1}",
      "title": "Evidence",
      "type": "object"
    }
  },
  "required": [
    "id",
    "symbol",
    "timeframe",
    "barIndex",
    "timestamp",
    "signalType",
    "direction",
    "strength"
  ],
  "title": "DetectedCondition",
  "type": "object"
}
